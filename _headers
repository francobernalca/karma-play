/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://francobernal.ca https://www.francobernal.ca; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), midi=(), serial=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Permitted-Cross-Domain-Policies: none

# DELIBERATELY NO X-Frame-Options.
# francobernal.ca embeds this game in a cross-origin iframe (the portal, see
# KARMA_URL in the site's script.js). X-Frame-Options has no working
# "allow one specific origin" value in modern browsers, so DENY or SAMEORIGIN
# would black out the portal. CSP frame-ancestors above supersedes it and does
# the job properly: only francobernal.ca may frame this, nobody else. Do not
# "harden" this by adding X-Frame-Options back.

# script-src and style-src are 'self' only: the game ships as ES modules in js/
# and one stylesheet, with no inline script, no inline style attributes in the
# markup, and runtime styling only through the CSSOM (which CSP allows).
# img-src keeps blob: because the animal and shape art is decoded from SVG
# strings into bitmaps for the canvas. The meta CSP in index.html mirrors this
# (minus frame-ancestors, which a meta tag cannot carry).

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Immutable for a year: new bytes always get a new file name.
/voice/*
  Cache-Control: public, max-age=31536000, immutable

/voice2/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
